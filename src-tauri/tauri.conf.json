{
  "productName": "Google Voice",
  "version": "1.0.0",
  "identifier": "com.gaboom813.voice-desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "https://voice.google.com",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Google Voice",
        "width": 1100,
        "height": 750,
        "url": "https://voice.google.com",
        "userAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"], 
    "identifier": "com.gaboom.google-voice",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": {
        "depends": ["webkit2gtk4-4.1", "libssl3", "libgtk-3-0"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "openssl-libs", "gtk3"]
      }
    }
  }
}
