{
  "productName": "Google Voice",
  "version": "1.0.0",
  "identifier": "com.gaboom813.voice-desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "https://voice.google.com",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png", 
      "icons/128x128.png", 
      "icons/128x128@2x.png", 
      "icons/icon.icns", 
      "icons/icon.ico"
    ]
  }
}